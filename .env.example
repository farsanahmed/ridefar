# ---------------------------------------------------------------------------
# RIDEFAR — environment template. Copy to .env.local and fill in.
# NEVER commit real values. No secret may ever reach client-side code.
# ---------------------------------------------------------------------------

# --- Supabase (Phase 2) -----------------------------------------------------
# Project settings -> API. The anon key is public-safe (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for admin-only writes and M-Pesa order creation.
SUPABASE_SERVICE_ROLE_KEY=

# --- M-Pesa Daraja STK Push (Phase 7) --------------------------------------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# "sandbox" or "production"
MPESA_ENVIRONMENT=sandbox

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" shows clearly-labelled DEMO products when no database is configured.
# Set to "false" (and configure Supabase) for real catalogue data.
NEXT_PUBLIC_DEMO_DATA=false
